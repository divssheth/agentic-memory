# ─── Authentication ───────────────────────────────────────────────────────────
# This project uses Entra ID (Azure AD) via DefaultAzureCredential.
# No API keys are needed, but you MUST run:
#
#   az login
#
# before running any notebook. Without this, all Azure calls will fail with 401.
# ──────────────────────────────────────────────────────────────────────────────

# Azure AI Foundry Project (used for chat completions / LLM)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_MODEL=gpt-5

# Azure OpenAI endpoint (used for embeddings)
# WHY A SEPARATE ENDPOINT? The Foundry project endpoint (above) routes chat
# completions through /openai/v1/chat/completions, but its /embeddings path
# does NOT support the required api-version parameter. The standard Azure OpenAI
# endpoint (below) exposes /openai/deployments/<model>/embeddings with proper
# api-version support. Both use the same underlying resource — just different
# routing. Auth is still Entra ID (no keys).
AZURE_OPENAI_ENDPOINT=https://your-service.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Module 2+: Episodic Memory - Cosmos DB
# COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
# COSMOS_KEY=your-cosmos-key
# COSMOS_DATABASE=travel-memory
# COSMOS_CONTAINER=episodic-memory
# COSMOS_SEMANTIC_CONTAINER=semantic-memory

# Module 3+: Semantic Memory - Neo4j
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# Module 4+: Procedural Memory - Azure AI Search
# AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
# AZURE_SEARCH_KEY=your-admin-key
# AZURE_SEARCH_INDEX=travel-policies

# Module 7+: Shared State - Redis
# REDIS_HOST=your-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your-access-key
